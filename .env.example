# Copy to .env and use: uv run aiops --env-file .env doctor
AIOPS_CODEX_BIN=codex
# Shared root for analysis metadata and collection/ batches + SQLite checkpoints
AIOPS_DATA_DIR=aiops_data
AIOPS_TIMEOUT_SECONDS=600
AIOPS_MAX_INPUT_BYTES=100000
