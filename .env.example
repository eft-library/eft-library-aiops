# Copy to .env and use: uv run aiops --env-file .env doctor
AIOPS_CODEX_BIN=codex
# Shared root for analysis metadata and collection/ batches + SQLite checkpoints
AIOPS_DATA_DIR=aiops_data
AIOPS_TIMEOUT_SECONDS=600
AIOPS_MAX_INPUT_BYTES=100000
# Omit to use Codex's default model (user config is not loaded).
# AIOPS_MODEL=

# Phase 3: leave unset to keep the existing local SQLite report mode.
# Use a dedicated database on the existing PostgreSQL server; no new DB port is opened.
# AIOPS_DATABASE_URL="host=127.0.0.1 port=13245 dbname=eft_library_aiops user=aiops_app"
# PGPASSWORD="replace-with-database-password"
# Alternatively configure PGPASSFILE with a private libpq password file.
